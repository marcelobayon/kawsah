---
import { routeTargetHref } from "../data/routes.js";
const { route, showQuestion = false } = Astro.props;
const t = route ? routeTargetHref(route) : null;
const gaEvent = route?.ecosystemKey
  ? "ecosystem_referral_clicked"
  : route?.type === "calculator"
    ? "calculator_cta_clicked"
    : "tool_cta_clicked";
---
{route && t && (
  <article class="card hover">
    <p class="card-meta"><span class="pill stage">{route.lifecycleStage}</span></p>
    <h3>{route.title}</h3>
    <p class="muted">{route.intent}</p>
    {showQuestion && <p class="measure" style="margin-top:.55rem"><strong>{route.nextQuestion}</strong></p>}
    <div class="card-cta">
      <a
        class={`btn btn-outline sm ${t.external ? "ext" : ""}`}
        href={t.url}
        target={t.external ? "_blank" : undefined}
        rel={t.external ? "noopener" : undefined}
        data-ga-event={gaEvent}
        data-ga-route={route.id}
        data-ga-cta={route.primaryCTA}
        data-ga-tool={route.title}
        data-ga-stage={route.lifecycleStage}
        {...(route.ecosystemKey ? { "data-ga-brand": route.ecosystemKey } : {})}
      >
        {route.primaryCTA}
      </a>
    </div>
  </article>
)}
