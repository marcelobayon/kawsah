---
import { FOOTER_GROUPS } from "../data/nav.js";
import { CONFIG, isSet } from "../config/config.js";
const year = new Date().getFullYear();
const lic = CONFIG.license;
const c = CONFIG.contact;
const social = CONFIG.social || {};
const socials = [
  ["Facebook", social.facebook],
  ["Instagram", social.instagram],
  ["YouTube", social.youtube],
  ["LinkedIn", social.linkedin],
  ["X", social.twitter],
  ["Tumblr", social.tumblr],
].filter(([, u]) => isSet(u));
---
<footer class="site-footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label={`${CONFIG.brand.name} home`}>
        <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <rect x="5" y="4" width="5.4" height="24" rx="1.3" fill="#0DB8AD"/>
          <line x1="9.5" y1="16" x2="27" y2="4.5" stroke="#e8f6f4" stroke-width="4.4" stroke-linecap="round"/>
          <line x1="9.5" y1="16" x2="27" y2="27.5" stroke="#5ec2b9" stroke-width="4.4" stroke-linecap="round"/>
          <line x1="11" y1="15.5" x2="25.5" y2="6" stroke="#0f403c" stroke-width="1.1" stroke-dasharray="2.2 2.2" stroke-linecap="round"/>
        </svg>
        <span>{CONFIG.brand.name}</span>
      </a>
      <p>{CONFIG.brand.tagline}</p>
      <div class="footer-contact">
        {isSet(c.email) && <a href={`mailto:${c.email}`}>{c.email}</a>}
        {isSet(c.phoneDisplay) && <a href={c.phoneHref}>{c.phoneDisplay}</a>}
      </div>
      {socials.length > 0 && (
        <nav class="footer-social" aria-label="Kawsah on social media">
          {socials.map(([label, href]) => (
            <a href={href} target="_blank" rel="noopener">{label}</a>
          ))}
        </nav>
      )}
    </div>

    {FOOTER_GROUPS.map((g) => (
      <div class="footer-col">
        <h4>{g.title}</h4>
        <ul>
          {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    ))}
  </div>

  <div class="container footer-bottom">
    <p class="legal">
      <strong>{CONFIG.brand.name}</strong> provides mortgage education and homeownership
      navigation tools. Calculators and tools provide <strong>estimates for planning only</strong> and
      are not loan offers, approvals, rates, or guarantees. Actual financing terms depend on lender
      and program requirements and verification of your information. Nothing here is financial, legal,
      or tax advice — consult a qualified professional about your specific situation.
    </p>
    <p>
      {lic.originator}, Mortgage Loan Originator, NMLS&nbsp;#{lic.nmls}.{" "}
      {isSet(lic.companyName) && isSet(lic.companyNmls) && (
        <span>{lic.companyName}, NMLS&nbsp;#{lic.companyNmls}. </span>
      )}
      {lic.equalHousing && <span>Equal Housing Opportunity.</span>}
    </p>
    <p>© {year} {CONFIG.brand.name}. All rights reserved.</p>
  </div>
</footer>
