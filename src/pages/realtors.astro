---
import Page from "../layouts/Page.astro";
import LeadForm from "../components/LeadForm.astro";
import NextStep from "../components/NextStep.astro";
import Disclaimer from "../components/Disclaimer.astro";
import { getRoute } from "../data/routes.js";

const route = getRoute("KAWSAH_REALTOR_PRO");
const features = [
  { h: "Productivity systems", p: "Templates and workflows that keep transactions moving without the mental overhead." },
  { h: "Marketing & content", p: "Campaigns and content that keep you top of mind with past and future clients." },
  { h: "Client tools", p: "Hand buyers the same Kawsah clarity — tools that make you look like the pro you are." },
  { h: "AI resources", p: "Practical AI helpers built from real real-estate workflow, not hype." },
];
---
<Page
  title="Realtor Toolkit"
  seoTitle="Realtor Toolkit"
  description="A growing toolkit for Realtors: productivity systems, marketing and content, client tools, and practical AI resources — built from real real-estate workflow."
  eyebrow="For Realtors"
  lede="Tools to help you run a smoother business and give your buyers a genuinely better experience. This toolkit is actively being built — get on the list to shape it."
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Professionals", href: "/professionals/" }, { label: "Realtors" }]}
  viewEvent="professional_route_started"
  route={route}
>
  <section class="section tight">
    <div class="container">
      <div class="grid cols-2">
        {features.map((f) => <div class="card"><h3>{f.h}</h3><p class="muted">{f.p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section tight paper">
    <div class="container narrow">
      <div class="card">
        <LeadForm
          name="realtor-toolkit"
          heading="Get early access"
          subtext="Tell us what would help most in your business — we're building this with working agents."
          cta="Join the list"
          source="realtors"
        />
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <NextStep route={route} />
      <div style="margin-top:1.4rem"><Disclaimer variant="general" /></div>
    </div>
  </section>
</Page>
