---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---
<Base title="Page not found" description="That page doesn't exist. Find your next step with Kawsah." noindex={true}>
  <section class="section">
    <div class="container narrow center">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page</h1>
      <p class="lede center">The link may be old or mistyped. Let's get you back to a clear next step.</p>
      <div class="btn-row" style="justify-content:center;margin-top:1.6rem">
        <Button href="/" variant="primary" size="lg">Go home</Button>
        <Button href="/route-finder/" variant="outline" size="lg">Find My Path</Button>
      </div>
      <p style="margin-top:1.5rem">
        Or jump to <a href="/affordability/">Affordability</a>, <a href="/purchase/">Buying a home</a>,
        or <a href="/refinance/">Refinance</a>.
      </p>
    </div>
  </section>
</Base>
